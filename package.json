{
  "name": "nextdesk",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MASolutionExpert/NEXTDESK.git"
  },
  "bugs": {
    "url": "https://github.com/MASolutionExpert/NEXTDESK/issues"
  },
  "homepage": "https://github.com/MASolutionExpert/NEXTDESK#readme",
  "scripts": {
    "dev": "APP_ENV=development NODE_ENV=development node server.mjs",
    "dev:all": "concurrently \"npm run dev\" \"npm --prefix worker run dev\"",
    "build": "next build",
    "start": "APP_ENV=production NODE_ENV=production node server.mjs",
    "start:all": "concurrently \"npm run start\" \"npm --prefix worker run start\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "concurrently \"npm run test:client:unit\" \"npm run test:server\" \"npm run test:worker\"",
    "test:client": "vitest --run",
    "test:client:unit": "vitest --project unit --run",
    "test:client:browser": "vitest --project browser --run",
    "test:server": "npm --prefix server run test",
    "test:worker": "npm --prefix worker run test",
    "test:coverage": "concurrently \"vitest --coverage --run\" \"npm --prefix server run test:coverage\" \"npm --prefix worker run test:coverage\"",
    "test:bench": "concurrently \"vitest bench --run\" \"npm --prefix server run test:bench\" \"npm --prefix worker run test:bench\"",
    "test:scripts": "bats scripts/test/",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:doctor": "npm --prefix server run db:doctor",
    "db:backup": "npm --prefix server run db:backup",
    "db:inspect": "npm --prefix server run db:inspect",
    "remote:configure": "npm --prefix server run remote:configure",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "dotenv": "^18.0.10",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.77.0",
    "marked": "^18.2.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.6",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "concurrently": "^10.0.7",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "playwright": "1.65.1",
    "postcss": "^8.5.33",
    "railway": "^3.17.0",
    "semantic-release": "^26.0.1",
    "tailwindcss": "^4.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.1",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.18.0"
  },
  "volta": {
    "node": "24.22.1",
    "npm": "11.18.0"
  },
  "overrides": {
    "shell-quote": "^1.10.0",
    "minimatch": "10.2.5"
  }
}
