{
  "name": "nextdesk",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MASolutionExpert/NEXTDESK.git"
  },
  "bugs": {
    "url": "https://github.com/MASolutionExpert/NEXTDESK/issues"
  },
  "homepage": "https://github.com/MASolutionExpert/NEXTDESK#readme",
  "scripts": {
    "dev": "APP_ENV=development NODE_ENV=development node server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm --prefix worker run dev\"",
    "build": "next build",
    "start": "APP_ENV=production NODE_ENV=production node server.ts",
    "start:all": "concurrently \"npm run start\" \"npm --prefix worker run start\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server.ts next.config.ts vitest.config.ts",
    "lint:fix": "eslint src server.ts next.config.ts vitest.config.ts --fix",
    "test": "concurrently \"npm run test:client:unit\" \"npm run test:server\" \"npm run test:worker\"",
    "test:client": "vitest --project unit --project browser --run",
    "test:client:unit": "vitest --project unit --run",
    "test:client:browser": "vitest --project browser --run",
    "test:server": "vitest --project server --run",
    "test:worker": "npm --prefix worker run test",
    "test:coverage": "concurrently \"vitest --coverage --run\" \"npm --prefix worker run test:coverage\"",
    "test:bench": "concurrently \"vitest bench --run\" \"npm --prefix worker run test:bench\"",
    "test:scripts": "bats scripts/test/",
    "db:delete": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/delete-db.ts",
    "db:reset": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/reset-db.ts",
    "db:backup": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/backup-db.ts",
    "db:restore": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/restore-db.ts",
    "db:vacuum": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/vacuum-db.ts",
    "db:help": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/db-help.ts",
    "db:migrate": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/migrate.ts",
    "db:doctor": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/db-doctor.ts",
    "db:backfill": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/backfill-message-file-metadata.ts",
    "db:chat:create": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/create-chat.ts",
    "db:chat:add": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/add-chat-member.ts",
    "db:chat:edit": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/edit-chat.ts",
    "db:chat:verify": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/verify-chat.ts",
    "db:chat:delete": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/delete-chat.ts",
    "db:file:delete": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/delete-file.ts",
    "db:user:edit": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/edit-user.ts",
    "db:user:ban": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/ban-user.ts",
    "db:user:verify": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/verify-user.ts",
    "db:user:delete": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/delete-user.ts",
    "db:user:create": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/create-user.ts",
    "db:owner:check": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/check-owner.ts",
    "db:user:generate": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/generate-user.ts",
    "db:message:generate": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/generate-chat-message.ts",
    "db:inspect": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/inspect-db.ts all",
    "db:chat:inspect": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/inspect-db.ts chat",
    "db:user:inspect": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/inspect-db.ts user",
    "db:file:inspect": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/inspect-db.ts file",
    "remote:configure": "node src/server/scripts/configure-remote-channel.ts",
    "storage:cors": "node src/server/scripts/configure-bucket-cors.ts",
    "storage:migrate": "/bin/bash -p scripts/run-data-command.sh node src/server/scripts/migrate-storage-layout.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "bullmq": "^6.7.8",
    "compression": "^1.8.2",
    "dompurify": "^3.4.18",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "highlight.js": "^11.12.0",
    "https-proxy-agent": "^9.1.0",
    "ioredis": "^6.0.0",
    "knex": "^3.3.0",
    "lucide-react": "^1.77.0",
    "marked": "^18.2.1",
    "multer": "^2.5.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.17.0",
    "telegram": "^2.26.22",
    "undici": "^8.13.0",
    "web-push": "^4.0.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.6",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "concurrently": "^10.0.7",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "playwright": "1.65.1",
    "postcss": "^8.5.33",
    "railway": "^3.17.0",
    "semantic-release": "^26.0.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.1",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.18.0"
  },
  "volta": {
    "node": "24.22.1",
    "npm": "11.18.0"
  },
  "overrides": {
    "shell-quote": "^1.10.0",
    "minimatch": "10.2.5"
  }
}
